{% comment %}
  Single source of truth for the theme-managed catalog.

  Params:
    handle - product handle, e.g. 'cacao-powder'
    mode   - 'card' (shop grid tile) or 'detail' (product page)

  To add a product: add a `when` branch below, drop <handle>.webp and
  <handle>-pack.webp in assets/, and add the handle to the list in
  sections/ts-main-collection.liquid.
{% endcomment %}

{% liquid
  assign p_origin = 'Single Origin · Product of Guatemala'
  assign p_badge = 'Zero Sugar'
  assign p_ingredients = '100% Pure Cacao (Theobroma cacao)'
  assign p_storage = 'Refrigeration not required. Store in a cool, dark, dry place.'
  assign p_tagline = "From Guatemala's volcanic region. Mineral-rich volcanic soil, rainforest climate and careful cultivation result in cacao that is aromatic, nutrient-dense and flavor-forward."
  assign p_net_wt = '8oz (227g)'
  assign p_servings = ''
  assign p_bullets = 'Rich chocolate taste;Full-bodied aroma;Deliciously unsweetened'
  assign p_name = ''
  assign p_uses = ''

  case handle
    when 'cacao-powder'
      assign p_name = 'Cacao Powder'
      assign p_uses = 'Chocolatiering;Baking;Skin & Body Care'
      assign p_servings = '38 servings (1 tbsp / 6g)'
    when 'cacao-beans'
      assign p_name = 'Cacao Beans'
      assign p_uses = 'Brewing;Smoothies;Snacks;Baking'
      assign p_servings = '57 servings (3–4 beans / 4g)'
    when 'cacao-nibs'
      assign p_name = 'Cacao Nibs'
      assign p_uses = 'Snacking;Smoothies;Salads;Baking'
      assign p_servings = '8 servings (2 tbsp / 28g)'
    when 'cacao-butter'
      assign p_name = 'Cacao Butter'
      assign p_uses = 'Tempering;Ice Creams;Desserts;Baking'
      assign p_servings = '11 servings (1 tbsp / 20g)'
    when 'cacao-wafers'
      assign p_name = 'Cacao Wafers'
      assign p_uses = 'Tempering;Ice Creams;Desserts;Baking'
      assign p_servings = '15 servings (2 wafers / 15g)'
    when 'cacao-tea'
      assign p_name = 'Cacao Tea'
      assign p_uses = 'Brewing;Smoothies'
      assign p_servings = '43 servings (1 tsp / 4g)'
      assign p_net_wt = '6oz (170g)'
  endcase

  assign p_size = '8oz'
  if handle == 'cacao-tea'
    assign p_size = '6oz'
  endif
  assign shop_product = all_products[handle]

  assign p_img = handle | append: '.webp' | asset_url
  assign p_pack = handle | append: '-pack.webp' | asset_url
  assign p_url = '/products/' | append: handle

  assign url_contact = '/pages/contact'
  if pages['contact'] != blank
    assign url_contact = pages['contact'].url
  endif
%}

{% if p_name == blank %}
  {% comment %}Unknown handle — render nothing rather than an empty shell.{% endcomment %}
{% elsif mode == 'card' %}

  {%- liquid
    assign rating = 4.5
    if shop_product.metafields.custom.rating.value != blank
      assign rating = shop_product.metafields.custom.rating.value | plus: 0.0
    endif
    assign full_stars = rating | floor
    assign has_half = false
    assign remainder = rating | minus: full_stars
    if remainder >= 0.25
      assign has_half = true
    endif
    assign half_index = full_stars | plus: 1
  -%}

  <article class="ts-cat-tile">
    <a class="ts-cat-tile__link" href="{{ p_url }}">
      <div class="ts-cat-tile__media">
        <img src="{{ p_img }}" alt="{{ p_name | escape }} pack" loading="lazy">
        {% if p_badge != blank %}
          <span class="ts-cat-tile__badge">{{ p_badge }}</span>
        {% endif %}
      </div>
      <h3 class="ts-cat-tile__name">{{ p_name }}, {{ p_size }}</h3>
    </a>

    <div class="ts-cat-tile__stars" aria-label="Rated {{ rating }} out of 5">
      {%- for i in (1..5) -%}
        {%- if i <= full_stars -%}
          <svg class="is-full" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        {%- elsif i == half_index and has_half -%}
          <svg class="is-half" viewBox="0 0 24 24" aria-hidden="true"><defs><linearGradient id="h{{ handle }}{{ i }}"><stop offset="50%" stop-color="currentColor"/><stop offset="50%" stop-color="transparent"/></linearGradient></defs><path fill="url(#h{{ handle }}{{ i }})" d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        {%- else -%}
          <svg class="is-empty" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {% if shop_product != blank %}
      <p class="ts-cat-tile__price">{{ shop_product.price | money }}</p>

      {% if shop_product.available %}
        {% form 'product', shop_product, class: 'ts-cat-tile__form' %}
          <input type="hidden" name="id" value="{{ shop_product.selected_or_first_available_variant.id }}">
          <button type="submit" name="add" class="ts-cat-tile__atc">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6h15l-1.5 9h-12z"></path><circle cx="9" cy="20" r="1"></circle><circle cx="18" cy="20" r="1"></circle><path d="M6 6 5 3H2"></path></svg>
            Add to Cart
          </button>
        {% endform %}
      {% else %}
        <a class="ts-cat-tile__atc is-disabled" href="{{ p_url }}">Sold Out</a>
      {% endif %}
    {% else %}
      <a class="ts-cat-tile__atc" href="{{ p_url }}">View Product</a>
    {% endif %}
  </article>

{% else %}

  <div class="ts-pdp" data-ts-pdp>
    <div class="ts-pdp__gallery">
      <div class="ts-pdp__thumbs">
        <button type="button" class="ts-pdp__thumb is-active" data-ts-pdp-thumb data-src="{{ p_img }}" aria-label="Front of pack">
          <img src="{{ p_img }}" alt="" loading="lazy">
        </button>
        <button type="button" class="ts-pdp__thumb" data-ts-pdp-thumb data-src="{{ p_pack }}" aria-label="Front and back of pack">
          <img src="{{ p_pack }}" alt="" loading="lazy">
        </button>
      </div>
      <div class="ts-pdp__main">
        <img src="{{ p_img }}" alt="{{ p_name | escape }} pack" data-ts-pdp-main width="690" height="810">
      </div>
    </div>

    <div class="ts-pdp__info">
      <p class="ts-pdp__eyebrow">{{ p_origin }}</p>
      <h1 class="ts-pdp__title">{{ p_name }}</h1>
      <p class="ts-pdp__lead">{{ p_tagline }}</p>

      {% if p_bullets != blank %}
        <ul class="ts-pdp__bullets">
          {% assign bullet_items = p_bullets | split: ';' %}
          {% for item in bullet_items %}
            <li>{{ item | strip | escape }}</li>
          {% endfor %}
        </ul>
      {% endif %}

      {% if p_uses != blank %}
        <div class="ts-pdp__uses">
          <span class="ts-pdp__label">Perfect for</span>
          <div class="ts-pdp__chips">
            {% assign use_items = p_uses | split: ';' %}
            {% for item in use_items %}
              <span class="ts-pdp__chip">{{ item | strip | escape }}</span>
            {% endfor %}
          </div>
        </div>
      {% endif %}

      <dl class="ts-pdp__specs">
        {% if p_net_wt != blank %}
          <div><dt>Net wt.</dt><dd>{{ p_net_wt }}</dd></div>
        {% endif %}
        {% if p_servings != blank %}
          <div><dt>Servings</dt><dd>{{ p_servings }}</dd></div>
        {% endif %}
        <div><dt>Ingredients</dt><dd>{{ p_ingredients }}</dd></div>
        <div><dt>Storage</dt><dd>{{ p_storage }}</dd></div>
      </dl>

      {% if shop_product != blank %}
        <p class="ts-pdp__price">{{ shop_product.price | money }}</p>
        {% if shop_product.available %}
          {% form 'product', shop_product, class: 'ts-pdp__form' %}
            <input type="hidden" name="id" value="{{ shop_product.selected_or_first_available_variant.id }}">
            <button type="submit" name="add" class="ts-btn ts-btn--primary ts-pdp__cta">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6h15l-1.5 9h-12z"></path><circle cx="9" cy="20" r="1"></circle><circle cx="18" cy="20" r="1"></circle><path d="M6 6 5 3H2"></path></svg>
              Add to Cart
            </button>
          {% endform %}
        {% else %}
          <p class="ts-pdp__soldout">Currently sold out</p>
        {% endif %}
      {% endif %}

      <a class="ts-pdp__enquire" href="{{ url_contact }}">Enquire about bulk orders →</a>

      <a class="ts-pdp__back" href="{{ routes.all_products_collection_url }}">← Back to all products</a>
    </div>
  </div>

{% endif %}
