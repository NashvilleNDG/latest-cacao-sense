{% comment %}
  Shop page — theme-managed catalog grid.

  Tiles show image + name only; full details live on the product page
  (/products/<handle>), rendered by snippets/ts-product-info.liquid.

  To add a product: add its handle to snippets/ts-product-handles.liquid, add a
  `when` branch in snippets/ts-product-info.liquid, and drop <handle>.webp +
  <handle>-pack.webp in assets/.
{% endcomment %}

{%- capture handles_csv -%}{%- render 'ts-product-handles' -%}{%- endcapture -%}
{%- assign handles = handles_csv | strip | split: ',' -%}

{% if section.settings.show_banner %}
  <div class="ts-shop-banner">
    {% if section.settings.banner_image != blank %}
      <img src="{{ section.settings.banner_image | image_url: width: 2400 }}" alt="{{ section.settings.banner_alt | escape }}" width="{{ section.settings.banner_image.width }}" height="{{ section.settings.banner_image.height }}" loading="eager" fetchpriority="high">
    {% else %}
      <img src="{{ 'products-banner.webp' | asset_url }}" alt="{{ section.settings.banner_alt | escape }}" width="1666" height="896" loading="eager" fetchpriority="high">
    {% endif %}

    {% if section.settings.banner_heading != blank %}
      <div class="ts-shop-banner__copy">
        {% if section.settings.banner_eyebrow != blank %}
          <p class="ts-shop-banner__eyebrow">{{ section.settings.banner_eyebrow }}</p>
        {% endif %}
        <p class="ts-shop-banner__title">{{ section.settings.banner_heading | newline_to_br }}</p>
        {% if section.settings.banner_sub != blank %}
          <p class="ts-shop-banner__sub">{{ section.settings.banner_sub }}</p>
        {% endif %}
      </div>
    {% endif %}
  </div>
{% endif %}

{%- capture group_markup -%}{%- endcapture -%}

<section class="ts-catalog ts-page-width">
  {%- assign groups = 'one,two' | split: ',' -%}
  {%- for g in groups -%}
    {%- liquid
      if g == 'one'
        assign g_eyebrow = section.settings.g1_eyebrow
        assign g_heading = section.settings.g1_heading
        assign g_accent = section.settings.g1_accent
        assign g_sub = section.settings.g1_sub
        assign g_handles = section.settings.g1_handles | split: ','
        assign g_cols = 'is-4up'
      else
        assign g_eyebrow = section.settings.g2_eyebrow
        assign g_heading = section.settings.g2_heading
        assign g_accent = section.settings.g2_accent
        assign g_sub = section.settings.g2_sub
        assign g_handles = section.settings.g2_handles | split: ','
        assign g_cols = 'is-3up'
      endif
    -%}

    {%- if g_handles.size > 0 and g_heading != blank -%}
      <div class="ts-collgroup">
        <header class="ts-collgroup__head">
          <div class="ts-collgroup__headings">
            {% if g_eyebrow != blank %}<p class="ts-collgroup__eyebrow">{{ g_eyebrow }}</p>{% endif %}
            <h2 class="ts-collgroup__title">
              {{ g_heading }}{% if g_accent != blank %} <em>{{ g_accent }}</em>{% endif %}
            </h2>
            {% if g_sub != blank %}<p class="ts-collgroup__sub">{{ g_sub }}</p>{% endif %}
          </div>

          {% if g == 'one' and section.settings.show_sticker %}
            <div class="ts-collgroup__sticker">
              {% if section.settings.sticker_image != blank %}
                <img src="{{ section.settings.sticker_image | image_url: width: 600 }}" alt="{{ section.settings.sticker_alt | escape }}" width="600" height="600" loading="lazy">
              {% else %}
                <img src="{{ 'white-beans-sticker.png' | asset_url }}" alt="{{ section.settings.sticker_alt | escape }}" width="600" height="600" loading="lazy">
              {% endif %}
            </div>
          {% endif %}
        </header>

        <div class="ts-catalog__grid {{ g_cols }}">
          {% for handle in g_handles %}
            {% render 'ts-product-info', handle: handle | strip, mode: 'card' %}
          {% endfor %}
        </div>
      </div>
    {%- endif -%}
  {%- endfor -%}

  {% if section.settings.view_all_label != blank %}
    <div class="ts-catalog__viewall">
      <a class="ts-btn-outline" href="{{ section.settings.view_all_link | default: routes.all_products_collection_url }}">{{ section.settings.view_all_label }}</a>
    </div>
  {% endif %}

  {% if section.settings.note != blank %}
    <p class="ts-catalog__note">{{ section.settings.note }}</p>
  {% endif %}
</section>

{% if section.settings.show_goodfor %}
  {%- liquid
    assign url_recipes = '/pages/recipes'
    if pages['recipes'] != blank
      assign url_recipes = pages['recipes'].url
    endif
    assign gf_keys = 'powder,wafers,nibs,tea,butter,beans' | split: ','
    assign gf_names = section.settings.goodfor_names | split: ','
  -%}
  <section class="ts-goodfor">
    <h2 class="ts-goodfor__title">{{ section.settings.goodfor_title }}</h2>
    <div class="ts-goodfor__row ts-page-width">
      {% for key in gf_keys %}
        {% assign label = gf_names[forloop.index0] | strip %}
        {% if label != blank %}
          <a class="ts-goodfor__item" href="{{ url_recipes }}">
            <span class="ts-goodfor__media">
              <img src="{{ 'recipe-out-' | append: key | append: '.webp' | asset_url }}" alt="{{ label | escape }}" width="1200" height="1200" loading="lazy">
            </span>
            <span class="ts-goodfor__label">{{ label }}</span>
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </section>
{% endif %}

{% schema %}
{
  "name": "Collection",
  "tag": "section",
  "class": "section-ts-collection",
  "settings": [
    { "type": "header", "content": "Banner" },
    { "type": "checkbox", "id": "show_banner", "label": "Show banner image", "default": true },
    { "type": "image_picker", "id": "banner_image", "label": "Banner image", "info": "Falls back to shop-hero.webp." },
    { "type": "text", "id": "banner_alt", "label": "Banner alt text", "default": "Cacao Senses product range" },
    { "type": "text", "id": "banner_eyebrow", "label": "Banner eyebrow", "default": "The Full Range" },
    { "type": "textarea", "id": "banner_heading", "label": "Banner heading (one line per row)", "default": "Six Ways\nto Taste\nCacao" },
    { "type": "text", "id": "banner_sub", "label": "Banner subtext", "default": "Single-origin. Nothing added." },

    { "type": "header", "content": "Good for" },
    { "type": "checkbox", "id": "show_goodfor", "label": "Show \"Good for\" strip", "default": true },
    { "type": "text", "id": "goodfor_title", "label": "Good for heading", "default": "Good for" },
    { "type": "text", "id": "goodfor_names", "label": "Labels (comma separated, matches recipe photos)", "default": "Ceremonial Drink,Chocolate Ganache,Energy Granola,Cacao Husk Tea,Whipped Body Balm,Trail Mix" },

    { "type": "header", "content": "Collection 1" },
    { "type": "text", "id": "g1_eyebrow", "label": "Eyebrow", "default": "Full Range" },
    { "type": "text", "id": "g1_heading", "label": "Heading", "default": "White Bean Premium" },
    { "type": "text", "id": "g1_accent", "label": "Heading accent (italic)", "default": "Collection" },
    { "type": "textarea", "id": "g1_sub", "label": "Subtitle", "default": "From raw whole beans to refined cacao butter — every form of pure cacao you need, all in one place." },
    { "type": "text", "id": "g1_handles", "label": "Product handles (comma separated)", "default": "cacao-beans,cacao-nibs,cacao-wafers,cacao-tea" },
    { "type": "checkbox", "id": "show_sticker", "label": "Show sticker badge", "default": true },
    { "type": "image_picker", "id": "sticker_image", "label": "Sticker image", "info": "Falls back to white-beans-sticker.png." },
    { "type": "text", "id": "sticker_alt", "label": "Sticker alt text", "default": "Specialty White Cacao Beans" },

    { "type": "header", "content": "Collection 2" },
    { "type": "text", "id": "g2_eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "g2_heading", "label": "Heading", "default": "Specialty" },
    { "type": "text", "id": "g2_accent", "label": "Heading accent (italic)", "default": "Collection" },
    { "type": "textarea", "id": "g2_sub", "label": "Subtitle" },
    { "type": "text", "id": "g2_handles", "label": "Product handles (comma separated)", "default": "cacao-powder,cacao-beans,cacao-nibs,cacao-butter,cacao-wafers,cacao-tea" },

    { "type": "header", "content": "View all" },
    { "type": "text", "id": "view_all_label", "label": "Button label", "default": "View All Products" },
    { "type": "url", "id": "view_all_link", "label": "Button link" },

    {
      "type": "textarea",
      "id": "note",
      "label": "Footer note",
      "default": "Every product is 100% pure cacao — no additives, no fillers, no sugar. Get in touch for availability and bulk enquiries."
    }
  ]
}
{% endschema %}
