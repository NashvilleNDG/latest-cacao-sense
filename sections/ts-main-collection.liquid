{% comment %}
  Shop page — theme-managed catalog grid.

  Tiles show image + name only; full details live on the product page
  (/products/<handle>), rendered by snippets/ts-product-info.liquid.

  To add a product: add its handle to snippets/ts-product-handles.liquid, add a
  `when` branch in snippets/ts-product-info.liquid, and drop <handle>.webp +
  <handle>-pack.webp in assets/.
{% endcomment %}

{%- capture handles_csv -%}{%- render 'ts-product-handles' -%}{%- endcapture -%}
{%- assign handles = handles_csv | strip | split: ',' -%}

{% if section.settings.show_banner %}
  <div class="ts-shop-banner">
    {% if section.settings.banner_image != blank %}
      <img src="{{ section.settings.banner_image | image_url: width: 2400 }}" alt="{{ section.settings.banner_alt | escape }}" width="{{ section.settings.banner_image.width }}" height="{{ section.settings.banner_image.height }}" loading="eager" fetchpriority="high">
    {% else %}
      <img src="{{ 'shop-hero.webp' | asset_url }}" alt="{{ section.settings.banner_alt | escape }}" width="1666" height="944" loading="eager" fetchpriority="high">
    {% endif %}
  </div>
{% endif %}

<section class="ts-catalog ts-page-width">
  <header class="ts-catalog__head">
    <p class="ts-products__kicker">{{ section.settings.kicker }}</p>
    <h1 class="ts-products__title">{{ section.settings.title }}</h1>
    {% if section.settings.intro != blank %}
      <p class="ts-catalog__intro">{{ section.settings.intro }}</p>
    {% endif %}
  </header>

  <div class="ts-catalog__grid">
    {% for handle in handles %}
      {% render 'ts-product-info', handle: handle, mode: 'card' %}
    {% endfor %}
  </div>

  {% if section.settings.note != blank %}
    <p class="ts-catalog__note">{{ section.settings.note }}</p>
  {% endif %}
</section>

{% if section.settings.show_goodfor %}
  {%- liquid
    assign url_recipes = '/pages/recipes'
    if pages['recipes'] != blank
      assign url_recipes = pages['recipes'].url
    endif
    assign gf_keys = 'powder,wafers,nibs,tea,butter,beans' | split: ','
    assign gf_names = section.settings.goodfor_names | split: ','
  -%}
  <section class="ts-goodfor">
    <h2 class="ts-goodfor__title">{{ section.settings.goodfor_title }}</h2>
    <div class="ts-goodfor__row ts-page-width">
      {% for key in gf_keys %}
        {% assign label = gf_names[forloop.index0] | strip %}
        {% if label != blank %}
          <a class="ts-goodfor__item" href="{{ url_recipes }}">
            <span class="ts-goodfor__media">
              <img src="{{ 'recipe-out-' | append: key | append: '.webp' | asset_url }}" alt="{{ label | escape }}" width="1200" height="1200" loading="lazy">
            </span>
            <span class="ts-goodfor__label">{{ label }}</span>
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </section>
{% endif %}

{% schema %}
{
  "name": "Collection",
  "tag": "section",
  "class": "section-ts-collection",
  "settings": [
    { "type": "header", "content": "Banner" },
    { "type": "checkbox", "id": "show_banner", "label": "Show banner image", "default": true },
    { "type": "image_picker", "id": "banner_image", "label": "Banner image", "info": "Falls back to shop-hero.webp." },
    { "type": "text", "id": "banner_alt", "label": "Banner alt text", "default": "Cacao Senses product range" },

    { "type": "header", "content": "Good for" },
    { "type": "checkbox", "id": "show_goodfor", "label": "Show \"Good for\" strip", "default": true },
    { "type": "text", "id": "goodfor_title", "label": "Good for heading", "default": "Good for" },
    { "type": "text", "id": "goodfor_names", "label": "Labels (comma separated, matches recipe photos)", "default": "Ceremonial Drink,Chocolate Ganache,Energy Granola,Cacao Husk Tea,Whipped Body Balm,Trail Mix" },

    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Shop"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Products"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "Single-origin cacao, grown on our own farms in the highlands of Guatemala and crafted in small batches."
    },
    {
      "type": "textarea",
      "id": "note",
      "label": "Footer note",
      "default": "Every product is 100% pure cacao — no additives, no fillers, no sugar. Get in touch for availability and bulk enquiries."
    }
  ]
}
{% endschema %}
